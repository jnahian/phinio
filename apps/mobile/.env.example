# Base URL of the Phinio web origin (where the tRPC + Better Auth
# endpoints live). Expo only exposes env vars prefixed with
# `EXPO_PUBLIC_` to runtime code, so the mobile-visible name MUST
# carry that prefix.
#
# For development on a real device, substitute your Mac's LAN IP so an
# iOS/Android device on the same Wi-Fi can reach `pnpm dev` on :3000.
# Find it with: ipconfig getifaddr en0
EXPO_PUBLIC_BETTER_AUTH_URL=http://192.168.1.x:3000
